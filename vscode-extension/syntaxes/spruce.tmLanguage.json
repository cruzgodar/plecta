{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.spruce",
	"patterns": [
		{ "include": "#declarationBlock" },
		{ "include": "#declarationBlockClose" },
		{ "include": "#displayMathBlock" },
		{ "include": "#inlineDisplayMath" },
		{ "include": "#inlineMath" }
	],
	"repository": {
		"declarationBlock": {
			"name": "meta.embedded.block.javascript.spruce",
			"begin": "^[ \\t]*(@@@)[ \\t]*([a-zA-Z0-9]+)[ \\t]*$",
			"while": "^(?![ \\t]*@@@)",
			"beginCaptures": {
				"1": { "name": "keyword.control.declaration-block.spruce" },
				"2": { "name": "entity.name.type.declaration-block.spruce" }
			},
			"contentName": "source.js",
			"patterns": [{ "include": "source.js" }]
		},
		"declarationBlockClose": {
			"match": "^[ \\t]*(@@@)[ \\t]*$",
			"captures": {
				"1": { "name": "keyword.control.declaration-block.spruce" }
			}
		},
		"displayMathBlock": {
			"name": "meta.embedded.block.latex.spruce",
			"begin": "^[ \\t]*(\\$\\$)[ \\t]*$",
			"end": "^[ \\t]*(\\$\\$)[ \\t]*$",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.math.begin.spruce" }
			},
			"endCaptures": {
				"1": { "name": "punctuation.definition.math.end.spruce" }
			},
			"contentName": "meta.math.block.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		},
		"inlineDisplayMath": {
			"name": "meta.embedded.line.latex.spruce",
			"begin": "\\$\\$",
			"end": "\\$\\$",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.math.begin.spruce" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.math.end.spruce" }
			},
			"contentName": "meta.math.inline.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		},
		"inlineMath": {
			"name": "meta.embedded.line.latex.spruce",
			"begin": "\\$(?!\\$)",
			"end": "\\$",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.math.begin.spruce" }
			},
			"endCaptures": {
				"0": { "name": "punctuation.definition.math.end.spruce" }
			},
			"contentName": "meta.math.inline.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		}
	}
}
