{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "source.spruce",
	"patterns": [
		{ "include": "#declarationBlock" },
		{ "include": "#displayMathBlock" },
		{ "include": "#inlineDisplayMath" },
		{ "include": "#inlineMath" }
	],
	"repository": {
		"declarationBlock": {
			"name": "meta.embedded.block.javascript.spruce",
			"begin": "^[ \\t]*(@@@)[ \\t]*([a-zA-Z0-9]*)[ \\t]*$",
			"end": "^[ \\t]*(@@@)[ \\t]*$|^(?=[ \\t]*@@@[ \\t]*[a-zA-Z0-9])",
			"beginCaptures": {
				"1": { "name": "keyword.declaration-block.spruce" },
				"2": { "name": "entity.name.type.declaration-block.spruce" }
			},
			"endCaptures": {
				"1": { "name": "keyword.declaration-block.spruce" }
			},
			"contentName": "source.js",
			"patterns": [
				{ "match": "\\binclude\\b(?=\\s*\\()", "name": "keyword.control.include.spruce" },
				{ "include": "source.js" }
			]
		},
		"displayMathBlock": {
			"name": "meta.embedded.block.latex.spruce",
			"begin": "^[ \\t]*(\\$\\$)[ \\t]*$",
			"end": "^[ \\t]*(\\$\\$)[ \\t]*$",
			"beginCaptures": {
				"1": { "name": "comment.delimiter.math.begin.spruce" }
			},
			"endCaptures": {
				"1": { "name": "comment.delimiter.math.end.spruce" }
			},
			"contentName": "meta.math.block.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		},
		"inlineDisplayMath": {
			"name": "meta.embedded.line.latex.spruce",
			"begin": "\\$\\$",
			"end": "\\$\\$",
			"beginCaptures": {
				"0": { "name": "comment.delimiter.math.begin.spruce" }
			},
			"endCaptures": {
				"0": { "name": "comment.delimiter.math.end.spruce" }
			},
			"contentName": "meta.math.inline.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		},
		"inlineMath": {
			"name": "meta.embedded.line.latex.spruce",
			"begin": "\\$(?!\\$)",
			"end": "\\$",
			"beginCaptures": {
				"0": { "name": "comment.delimiter.math.begin.spruce" }
			},
			"endCaptures": {
				"0": { "name": "comment.delimiter.math.end.spruce" }
			},
			"contentName": "meta.math.inline.latex",
			"patterns": [{ "include": "text.tex.latex" }]
		}
	}
}
