{
  "name": "spruce-language",
  "displayName": "Spruce Language",
  "description": "Syntax highlighting for the Spruce markup language via LSP semantic tokens",
  "version": "0.0.1",
  "publisher": "cruzgodar",
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./client/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "spruce",
        "aliases": ["Spruce", "spruce"],
        "extensions": [".sp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spruce",
        "scopeName": "source.spruce",
        "path": "./syntaxes/spruce.tmLanguage.json",
        "embeddedLanguages": {
          "source.js": "javascript",
          "meta.math.block.latex": "latex",
          "meta.math.inline.latex": "latex"
        }
      }
    ],
    "semanticTokenTypes": [
      { "id": "heading", "description": "Markdown-style heading line" },
      { "id": "bold", "description": "Bold span content" },
      { "id": "italic", "description": "Italic span content" },
      { "id": "boldItalic", "description": "Bold + italic span content" },
      { "id": "inlineCode", "description": "Inline `code` content" },
      { "id": "codeBlock", "description": "Fenced code block content" },
      { "id": "list", "description": "List marker (- or 1.)" },
      { "id": "function", "description": "@function call marker and name" },
      { "id": "marker", "description": "Inline syntax delimiter (backticks, asterisks, underscores)" }
    ],
    "semanticTokenScopes": [
      {
        "language": "spruce",
        "scopes": {
          "heading": ["markup.heading"],
          "inlineCode": ["variable"],
          "codeBlock": ["variable"],
          "list": ["markup.list"],
          "function": ["keyword"]
        }
      }
    ],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
          "bold:spruce": { "bold": true },
          "italic:spruce": { "italic": true },
          "boldItalic:spruce": { "bold": true, "italic": true },
          "marker:spruce": { "foreground": "#80808080" }
        }
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.delimiter.math",
            "settings": { "foreground": "#80808080" }
          }
        ]
      }
    }
  },
  "scripts": {
    "test": "node --test server/tokenizer.test.mjs"
  },
  "dependencies": {
    "ohm-js": "^17.5.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
